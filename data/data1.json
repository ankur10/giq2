    "merge": {
      "core": "Retained from get_connected_graph_data",
      "customers": "Retained from get_connected_graph_data",
      "segments": "inner_circle_segments mapped to nodes and grouped by hot_bet",
      "adjacentMarkets": "outer_circle_segments mapped to nodes",
      "fallback": "Retain the original graph ring if its YC circle data is unavailable or empty"
    },
    "delivery": "Merged graph is published as connected_markets.graph_data and rendered by the Connected Market tab"
  },
